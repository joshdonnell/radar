{
  "name": "@joshdonnell/radar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "mkdir -p public && echo 'http://localhost:5173' > public/hot && (trap 'rm -f public/hot' EXIT; vp dev)",
    "lint": "vp lint --fix && vp fmt resources/",
    "test:lint": "vp lint --type-aware && vp fmt --check resources/",
    "test:types": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite-plus": "^0.3.1",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "laravel-vite-plugin": "^3.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.8"
  },
  "packageManager": "npm@11.19.0"
}
